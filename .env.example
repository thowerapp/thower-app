# Copier en `.env` et renseigner les valeurs (ne pas commiter `.env`).

# ── Cloudflare Stream (upload admin, lecture signée, webhook transcodage) ─────
# Account ID : Cloudflare dashboard → aperçu du compte (ou URL Stream)
CLOUDFLARE_ACCOUNT_ID=
# Token API avec permissions Stream (ex. direct_upload, read, delete, token, webhook)
CLOUDFLARE_STREAM_API_TOKEN=
# Secret de signature des webhooks (identique à `secret` dans la réponse de
# `PUT /accounts/{id}/stream/webhook` — voir `scripts/register-stream-webhook.mjs`)
CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# ── Cloudflare R2 (photos de progression — bucket privé) ──────────────────────
# Token API avec permissions R2 : Object Read + Object Write sur le bucket photos
# Cloudflare dashboard → My Profile → API Tokens → Create Token
CLOUDFLARE_R2_API_TOKEN=
# Nom exact du bucket R2 (Cloudflare dashboard → R2 → Create bucket)
R2_BUCKET_NAME=
