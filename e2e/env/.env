# Environnement des tests Playwright : valeurs factices uniquement (aucun secret, aucun service réel).
# Chargé à la place du .env racine via THOWER_ENV_DIR=e2e/env (voir svelte.config.js et e2e/support/server.ts).
DATABASE_URL=mongodb://127.0.0.1:27037/thower_e2e?replicaSet=e2eset&directConnection=true
ENCRYPTION_KEY=2fQvc7GCIT4IExwjjSuwFw==
PUBLIC_URL=http://localhost:4380
CRON_SECRET=e2e-cron-secret
# Limite de débit par IP relevée : tous les tests viennent de 127.0.0.1.
RATE_LIMIT_MAX=1000000
# Paiement : clés factices, aucun appel Stripe ; les webhooks sont signés par les tests avec ce secret.
STRIPE_SECRET_KEY=sk_test_e2e_not_a_real_key
STRIPE_WEBHOOK_SECRET=whsec_e2e_test_secret
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_e2e_not_a_real_key
# Emails : port fermé, aucun envoi (les codes de vérification sont lus en base par les tests).
SMTP_HOST=127.0.0.1
SMTP_PORT=9
SMTP_USER=e2e
SMTP_PASS=e2e
SMTP_FROM=e2e@test.local
CONTACT_NOTIFICATION_EMAIL=e2e@test.local
GOOGLE_CLIENT_ID=e2e
GOOGLE_CLIENT_SECRET=e2e
VITE_GOOGLE_REDIRECT_URI=http://localhost:4380/auth/login/google/callback
SECRET_OPENCAGEDATA_KEY=e2e
CLOUDINARY_CLOUD_NAME=e2e
CLOUDINARY_API_KEY=e2e
CLOUDINARY_API_SECRET=e2e
CLOUDFLARE_ACCOUNT_ID=e2e
CLOUDFLARE_STREAM_API_TOKEN=e2e
CLOUDFLARE_STREAM_WEBHOOK_SECRET=e2e
CLOUDFLARE_R2_API_TOKEN=e2e
R2_BUCKET_NAME=e2e
GEMINI_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:e2e@test.local
# Présentes dans le .env racine : définies vides pour qu'aucun dotenv.config() ne reprenne la vraie valeur.
PUBLIC_ENV=e2e
SECRET_NAME_DATA_COOKIE=
PUBLIC_TINYMCE_API_KEY=
SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_SECRET_KEY=
SENDCLOUD_INTEGRATION_ID=
SECRET_CONTENTFUL_ACCESS_TOKEN=
SECRET_CONTENTFUL_SPACE_ID=
STRIPE_WEBHOOK_SECRET_PREVIEW=
STRIPE_WEBHOOK_SECRET_CLI=
# Caches serveur désactivés : chaque test prépare ses propres données (voir src/lib/server/cache/ttlCache.ts).
THOWER_DISABLE_SERVER_CACHE=1
