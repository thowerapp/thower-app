{
	"name": "sveltekit-boilerplate",
	"version": "0.0.1",
	"type": "module",
	"config": {
		"mongodbMemoryServer": {
			"disablePostinstall": "1"
		}
	},
	"scripts": {
		"postinstall": "prisma generate",
		"clean:vite": "rimraf node_modules/.vite .vite_cache",
		"dev": "vite dev --port 2000",
		"cacheclean": "npm cache clean --force",
		"sync": "svelte-kit sync",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"prettier:watch": "chokidar \"src/**/*.{js,ts,svelte,scss}\" -c \"npm run prettier:single -- {path}\"",
		"prettier:single": "prettier --write",
		"prettier": "prettier --write \"src/**/*.{js,ts,svelte,scss}\"",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"model-pipeline:run": "node scripts/model-pipeline.js",
		"seed": "node src/lib/server/seed.js",
		"seed:admin": "node src/lib/server/seedAdmin.js",
		"reset": "node src/lib/server/resetDb.js",
		"stream:register-webhook": "node scripts/register-stream-webhook.mjs",
		"migrate:measurements": "tsx scripts/migrate-measurements-to-profile-and-body.ts",
		"reset:all-programs": "tsx scripts/reset-all-programs.ts",
		"set:program-start": "tsx scripts/set-program-start.ts"
	},
	"devDependencies": {
		"@internationalized/date": "^3.11.0",
		"@lucide/svelte": "^0.575.0",
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.52.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/aspect-ratio": "^0.4.2",
		"@tailwindcss/container-queries": "^0.1.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/postcss": "^4.1.18",
		"@tailwindcss/typography": "^0.5.19",
		"@tanstack/table-core": "^8.21.3",
		"@types/eslint": "^9.6.1",
		"@types/node": "^25.2.3",
		"@types/nodemailer": "^7.0.9",
		"@types/three": "^0.183.1",
		"@types/web-push": "^3.6.4",
		"autoprefixer": "^10.4.24",
		"bits-ui": "^2.15.5",
		"chokidar": "^5.0.0",
		"chokidar-cli": "^3.0.0",
		"clsx": "^2.1.1",
		"concurrently": "^9.2.1",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^9.27.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.0",
		"formsnap": "^2.0.1",
		"globals": "^17.3.0",
		"layerchart": "^2.0.0-next.10",
		"lucide-svelte": "^0.564.0",
		"mode-watcher": "^1.1.0",
		"mongodb-memory-server": "^11.2.0",
		"paneforge": "^1.0.2",
		"postcss": "^8.5.6",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
