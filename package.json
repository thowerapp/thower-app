{
	"name": "sveltekit-boilerplate",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"postinstall": "prisma generate",
		"clean:vite": "rimraf node_modules/.vite .vite_cache",
		"dev": "vite dev --port 2000",
		"cacheclean": "npm cache clean --force",
		"sync": "svelte-kit sync",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"prettier:watch": "chokidar \"src/**/*.{js,ts,svelte,scss}\" -c \"npm run prettier:single -- {path}\"",
		"prettier:single": "prettier --write",
		"prettier": "prettier --write \"src/**/*.{js,ts,svelte,scss}\"",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"model-pipeline:run": "node scripts/model-pipeline.js",
		"seed": "node src/lib/server/seed.js",
		"seed:admin": "node src/lib/server/seedAdmin.js",
		"reset": "node src/lib/server/resetDb.js",
		"stream:register-webhook": "node scripts/register-stream-webhook.mjs",
		"migrate:measurements": "tsx scripts/migrate-measurements-to-profile-and-body.ts",
		"reset:all-programs": "tsx scripts/reset-all-programs.ts"
	},
