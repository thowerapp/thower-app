datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ═══════════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════════

enum Role {
  ADMIN
  CLIENT
}

enum ActivityLevel {
  SEDENTARY
  ACTIVE
  ATHLETE
}

/// Type de séance sport (A → B → C obligatoires + Découverte facultative)
enum WorkoutSessionType {
  MAIN_A
  MAIN_B
  MAIN_C
  DISCOVERY
}

/// Position d'une vidéo dans une séance
enum WorkoutVideoPosition {
  PRE    /// pré-séance facultative
  VID1   /// vidéo 1 obligatoire
  VID2   /// vidéo 2 obligatoire
}

/// Position d'un repas dans la journée
enum MealPosition {
  BREAKFAST
  LUNCH
  DINNER
}

/// Catégorie d'une recette
enum RecipeCategory {
  BREAKFAST /// Petit déjeuner
  MEAL      /// Repas (déjeuner / dîner)
  DESSERT   /// Dessert
}

/// Matériel de cuisine requis pour réaliser la recette (cases cochées côté admin)
enum RecipeKitchenEquipment {
  OVEN           /// Four
  MICROWAVE      /// Micro-ondes
  BLENDER        /// Blender
  AIR_FRYER      /// Air fryer
  KITCHEN_SCALE  /// Balance cuisine
  COOKTOP        /// Plaque de cuisson
}

/// Catégorie du contenu Découverte (Motivation, Explication, Breathwork…)
enum DiscoveryCategory {
  MEDITATION
  MINDSET
  BREATHWORK
  MOTIVATION   /// vidéos/audio motivation & discipline
  EXPLICATION  /// explication méthode (jeûne, protéine, cycle circadien, recettes…)
}

/// Type d’item sur un jour du programme 91 (défini par l’admin)
enum ProgramDayItemType {
  DAILY_TASK       /// tâche ligne directrice (eau, pas de téléphone…)
  VIDEO_OF_DAY     /// vidéo du jour (motivation / explication)
  BREATHWORK       /// respiration (lien vers vidéo)
  SPORT_SESSION    /// séance sport
  STEPS            /// nombre de pas (seuil optionnel, sync Health plus tard)
  MINDSET_VIDEO    /// mindset (discipline, etc.)
  CUSTOM           /// label + points libres (ex: ne pas manger de sucre 30 pts)
}

/// Angle pour les photos de progression
enum PhotoAngle {
  FRONT
  SIDE
  BACK
}

/// Statut de validation des photos d'inscription par l'admin
enum PhotoValidationStatus {
  PENDING
  VALIDATED
}

/// Type de pain — valeurs nutritionnelles de référence pour 100 g (usage calculs apports)
enum BreadType {
  WHITE_BAGUETTE /// Pain blanc (baguette)
  WHOLE_WHEAT    /// Pain complet
  RYE            /// Pain de seigle
  CORN           /// Pain de maïs
  COUNTRY        /// Pain de campagne
  MULTIGRAIN     /// Pain aux céréales
}

/// Type d'événement de points (gain positif / dépense négative)
enum PointEventType {
  WORKOUT_COMPLETE
  VIDEO_WATCHED
  DAILY_TASK
  BADGE_UNLOCK
  CHALLENGE_COMPLETE
  PHOTO_UPLOAD
  POINT_SPENT
  MONTHLY_CHECKIN
}


// ═══════════════════════════════════════════════════════════════════════════
// CONTACT (formulaire public)
// ═══════════════════════════════════════════════════════════════════════════

model Contact {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())

  @@map("contacts")
}


// ═══════════════════════════════════════════════════════════════════════════
// AUTH
// ═══════════════════════════════════════════════════════════════════════════

model User {
  id                        String                     @id @default(auto()) @map("_id") @db.ObjectId
  email                     String                     @unique
  username                  String?
  passwordHash              String?
  recoveryCode              String?
  emailVerified             Boolean                    @default(false)
  isMfaEnabled              Boolean                    @default(false)
  totpKey                   Bytes?
  googleId                  String?
  name                      String?
  picture                   String?
  role                      Role                       @default(CLIENT)
  /// Fin de validité de l'accès accompagnement (null = accès à vie ou non souscrit)
  subscriptionEndsAt        DateTime?
  /// Jours nutrition alloués (ex. +91 à chaque paiement validé) — génération des jours 1..N
  nutritionDaysAllocated    Int                        @default(0)
  /// Date de début du programme 91 jours (pour calculer le jour courant)
  programStartDate          DateTime?
  /// Stop/Report activé par l’admin uniquement (maladie, blessure)
  programPausedAt            DateTime?
  programPausedReason        String?
  /// Statut de validation des photos d'inscription (bloque accès au formulaire de mesures)
  photoValidationStatus     PhotoValidationStatus      @default(PENDING)
  /// Quand l'admin a validé les photos et saisi le % de masse graisseuse
  photoValidatedAt          DateTime?
  createdAt                 DateTime                   @default(now())

  // Auth
  transactions              Transaction[]
  sessions                  Session[]
  emailVerificationRequests EmailVerificationRequest[] @relation("UserEmailVerificationRequests")
  passwordResetSessions     PasswordResetSession[]     @relation("UserPasswordResetSessions")
  pushSubscriptions         PushSubscription[]

  // Profil & mensurations
  profile                   UserProfile?
  bodyMeasurements          BodyMeasurement[]

  // Sport (lot 3)
  workoutDays               UserWorkoutDay[]

  // Nutrition (lot 4 & 5)
  nutritionDays             NutritionDay[]
  recipes                   Recipe[]
  favoriteRecipes           UserFavoriteRecipe[]

  // Courses (lot 6)
  shoppingLists             ShoppingList[]

  // Gamification (lot 7)
  pointEvents               PointEvent[]
  userBadges                UserBadge[]

  // Checklist (lot 8)
  dailyTaskOptOuts          UserDailyTaskOptOut[]
  dailyTaskCompletions      DailyTaskCompletion[]

  // Vidéos Cloudflare Stream (sport + découverte) — progression unifiée
  videoProgress             UserVideoProgress[]

  // Progression (lot 10)
  progressPhotos            ProgressPhoto[]
  monthlyCheckIns           MonthlyCheckIn[]

  // Défis admin (lot 12)
  challenges                UserChallenge[]

  // Programme 91 jours — validations des items du jour
  programDayItemCompletions UserProgramDayItemCompletion[]
}

model Session {
  /// ID écrit par Lucia (nanoid) → plus de contrainte ObjectId
  id                String   @id @map("_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  expiresAt         DateTime
  twoFactorVerified Boolean  @default(false)
  oauthProvider     String?

  @@index([userId])
}

model EmailVerificationRequest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation("UserEmailVerificationRequests", fields: [userId], references: [id])
  userId    String   @db.ObjectId
  email     String
  code      String
  expiresAt DateTime
}

model PasswordResetSession {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  user              User     @relation("UserPasswordResetSessions", fields: [userId], references: [id])
  userId            String   @db.ObjectId
  email             String
  code              String
  expiresAt         DateTime
  emailVerified     Boolean  @default(false)
  twoFactorVerified Boolean  @default(false)
}


// ═══════════════════════════════════════════════════════════════════════════
// OFFRES — catalogue avec prix, sélection sur la page paiement (gestion admin)
// ═══════════════════════════════════════════════════════════════════════════

model Offer {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  slug               String   @unique
  name               String
  amountCentsMonthly Int
  amountCentsAnnual  Int
  active             Boolean  @default(true)
  order              Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("offers")
}


// ═══════════════════════════════════════════════════════════════════════════
// PAIEMENT
// ═══════════════════════════════════════════════════════════════════════════

model Transaction {
  id                     String   @id @default(auto()) @map("_id") @db.ObjectId
  stripePaymentId        String   @unique
  userId                 String?  @db.ObjectId
  amount                 Float
  currency               String
  status                 String
  customer_details_email String?  @default("")
  customer_details_name  String?  @default("")
  /// Offres achetées dans ce paiement (slugs)
  offerSlugs             String[] @default([])
  /// Une seule fois par session Stripe : crédit nutrition + abo (évite double incrément / course entre webhooks)
  nutritionSegmentCreditedAt DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user                   User?    @relation(fields: [userId], references: [id])

  @@map("transactions")
}


// ═══════════════════════════════════════════════════════════════════════════
// LOT 2 — PROFIL UTILISATEUR & ONBOARDING
// ═══════════════════════════════════════════════════════════════════════════

model UserProfile {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique @db.ObjectId

  // Physique & activité
  activityLevel              ActivityLevel?
  objectives                 String[]       @default([])

  // Santé & contre-indications
  painsPathologies           String?

  // Contexte
  contextParticular          String?

  // Habitudes alimentaires — pain (données structurées pour calculs macros)
  breadDaily                 Boolean        @default(false)
  /// Quantité moyenne consommée par jour (g) — utilisée même si consommation non quotidienne (équivalent journalier)
  breadGramsPerDay           Float?
  breadType                  BreadType?
  /// Précisions libres (optionnel)
  breadManagement            String?
  allergens                  String[]       @default([])
  coffeePerDay               Int?
  alcoholHabit               Boolean?
  tobaccoHabit               Boolean?
  breakfastEnabled           Boolean        @default(false)

  /// % masse grasse (saisie ou estimation ultérieure via IA / photos)
  bodyFatPercent             Float?
  /// Objectif de perte de poids (kg) — déficit réparti sur la période méthode (91 j)
  weightLossGoalKg           Float?

  // Jeûne intermittent (activation globale ; peut être surchargé par NutritionDay)
  intermittentFastingMorning Boolean?

  // Sport existant
  sportActivity              String?

  /// Coefficient famille en JSON — ex: [{"label":"Conjoint","coefficient":0.6},{"label":"Enfant","coefficient":0.5}]
  familyCoefficients         Json?
  /// Tri liste de courses : "category" | "alphabetical"
  shoppingListSortOrder      String?

  // Bien-être (échelle 1-10)
  stressLevel                Int?
  sleepQuality               Int?
  bodyConfidence             Int?
  digestionQuality           Int?
  happinessLevel             Int?
  readinessToChange          Int?

  // Alimentation & équipement
  kitchenEquipment           String[]       @default([])
  disgustingFoods            String?
  otherAllergens             String?

  // Objectifs détaillés
  physicalObjective          String?
  eventMotivation            String?

  // Addictions
  addictionsText             String?

  updatedAt                  DateTime       @updatedAt

  @@map("user_profiles")
}


// ═══════════════════════════════════════════════════════════════════════════
// LOT 2 / LOT 10 — MENSURATIONS (historique)
// ═══════════════════════════════════════════════════════════════════════════

model BodyMeasurement {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())

  age      Int?
  heightCm Float?
  weightKg Float?
  waistCm  Float?
  chestCm  Float?
  armCm    Float?

  @@index([userId])
  @@map("body_measurements")
}


// ═══════════════════════════════════════════════════════════════════════════
// PROGRAMME 91 JOURS — structure définie par l’admin (détail d’un jour)
// Gestion admin : CRUD Program, ProgramDay, ProgramDayItem, DayPopup à tout moment
// ═══════════════════════════════════════════════════════════════════════════

/// Programme Méthode Thower (91 jours) — un enregistrement, structure évolutive
model Program {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String?  @default("Méthode Thower")
  totalDays Int      @default(91)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  days    ProgramDay[]
  popups  DayPopup[]
}

/// Définition d’un jour (1 à 91) : liste d’items à cocher avec points
model ProgramDay {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId String   @db.ObjectId
  dayIndex  Int      /// 1–91
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     ProgramDayItem[]

  @@unique([programId, dayIndex])
  @@index([programId])
  @@map("program_days")
}

/// Un item à cocher sur un jour (tâche, vidéo du jour, breathwork, séance sport, custom…)
/// Admin : ajout/suppression/modification à tout moment (ex: « ne pas manger de sucre 30 pts »)
model ProgramDayItem {
  id             String              @id @default(auto()) @map("_id") @db.ObjectId
  programDay     ProgramDay          @relation(fields: [programDayId], references: [id], onDelete: Cascade)
  programDayId   String              @db.ObjectId
  type           ProgramDayItemType
  order          Int                 @default(0)
  points         Int                 @default(0)
  /// Pour CUSTOM ou surcharge d’affichage
  label          String?
  /// Seuil de pas pour type STEPS (ex: 5000 pas = points) — sync Health plus tard
  stepsThreshold Int?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  dailyTaskId         String?  @db.ObjectId
  dailyTask           DailyTask?         @relation(fields: [dailyTaskId], references: [id])
  discoveryContentId  String?  @db.ObjectId
  discoveryContent     DiscoveryContent? @relation(fields: [discoveryContentId], references: [id])
  workoutVideoId      String?  @db.ObjectId
  workoutVideo        WorkoutVideo?     @relation(fields: [workoutVideoId], references: [id])

  completions UserProgramDayItemCompletion[]

  @@index([programDayId])
  @@map("program_day_items")
}

/// Validation par l’utilisateur d’un item du jour (coche = points attribués)
model UserProgramDayItemCompletion {
  id                 String         @id @default(auto()) @map("_id") @db.ObjectId
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String         @db.ObjectId
  item               ProgramDayItem  @relation(fields: [programDayItemId], references: [id], onDelete: Cascade)
  programDayItemId   String         @db.ObjectId
  completedAt        DateTime       @default(now())
  /// Si type STEPS : valeur enregistrée (optionnel)
  stepsValue         Int?

  @@unique([userId, programDayItemId])
  @@index([userId])
  @@map("user_program_day_item_completions")
}

/// Pop-ups / messages motivants par jour (ex: jour 30 = vidéo 1 mois, message avant séance)
/// Admin : création et édition à tout moment
model DayPopup {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  programId String   @db.ObjectId
  dayIndex  Int
  type      String?  /// CELEBRATION_MONTH, SPORT_MESSAGE, etc.
  title     String?
  body      String?
  videoUrl  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
  @@map("day_popups")
}


// ═══════════════════════════════════════════════════════════════════════════
// LOT 3 — SPORT — catalogue géré par l’admin (séances + vidéos YouTube)
// ═══════════════════════════════════════════════════════════════════════════

/// Catalogue global de séances défini par l'admin
model WorkoutSession {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  type        WorkoutSessionType
  name        String
  description String?
  /// Numéro de semaine dans le programme (1–13 pour 91 jours)
  weekNumber  Int?
  order       Int                @default(0)
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  userDays         UserWorkoutDay[]

  @@map("workout_sessions")
}

/// Vidéo de séance sport — la position (PRE/VID1/VID2) détermine son rôle
/// Admin : ajout/suppression sans redéploiement (Cloudflare Stream)
model WorkoutVideo {
  id          String               @id @default(auto()) @map("_id") @db.ObjectId
  /// UID Cloudflare Stream — le même asset peut être référencé sur plusieurs fiches
  cloudflareUid   String
  title       String
  position    WorkoutVideoPosition
  isOptional  Boolean              @default(false)
  /// Durée en secondes — renseignée par le webhook Cloudflare quand la vidéo est ready
  durationSeconds Float?
  /// pending | ready | error — statut de traitement Cloudflare
  status      String               @default("pending")
  /// Vignette générée par Cloudflare (renseignée au webhook ready)
  thumbnailUrl String?
  updatedAt   DateTime             @updatedAt

  progress        UserVideoProgress[]
  programDayItems ProgramDayItem[]

  @@index([cloudflareUid])
  @@map("workout_videos")
}

/// Assignation d'une séance à un jour calendrier pour un utilisateur
model UserWorkoutDay {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String         @db.ObjectId
  session       WorkoutSession @relation(fields: [sessionId], references: [id])
  sessionId     String         @db.ObjectId
  /// Jour du programme 1–91
  dayIndex      Int
  scheduledDate DateTime?
  completedAt   DateTime?
  /// Verrouillé si le jour est passé
  isLocked      Boolean        @default(false)

  /// Une occurrence (même séance peut revenir plusieurs fois sur le programme 91j : J2, J9, J16…)
  @@unique([userId, sessionId, dayIndex])
  @@index([userId])
  @@map("user_workout_days")
}

/// Suivi de progression unifié d'une vidéo Cloudflare Stream (sport ou découverte)
/// Un seul des deux IDs (workoutVideoId / discoveryContentId) est renseigné.
/// completedAt est posé quand maxPositionSec atteint COMPLETION_THRESHOLD * durationSeconds (90 %)
/// ou que le player émet "ended". Sert aussi à attribuer les points (PointEvent VIDEO_WATCHED).
model UserVideoProgress {
  id                 String            @id @default(auto()) @map("_id") @db.ObjectId
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String            @db.ObjectId

  workoutVideo       WorkoutVideo?     @relation(fields: [workoutVideoId], references: [id], onDelete: Cascade)
  workoutVideoId     String?           @db.ObjectId

  discoveryContent   DiscoveryContent? @relation(fields: [discoveryContentId], references: [id], onDelete: Cascade)
  discoveryContentId String?           @db.ObjectId

  /// Position max atteinte par l'utilisateur (secondes)
  maxPositionSec     Float             @default(0)
  /// Dernière mise à jour côté serveur (heartbeat lecture)
  lastHeartbeatAt    DateTime          @default(now())
  /// Date de complétion (>= 90 % de la durée OU événement ended)
  completedAt        DateTime?

  /// Pas de @@unique sur les FK optionnels : MongoDB compterait plusieurs `null`
  /// comme doublons sur (userId, discoveryContentId). Unicité assurée en app (upsert).
  @@index([userId, workoutVideoId])
  @@index([userId, discoveryContentId])
  @@index([userId])
  @@map("user_video_progress")
}


// ═══════════════════════════════════════════════════════════════════════════
// LOT 4 & 5 — NUTRITION : RECETTES (catalogue admin + recettes perso)
// isCustom:false + userId:null  → recette catalogue admin (FIRST_3_MONTHS | NEW)
// isCustom:true  + userId:set   → recette personnelle créée par un utilisateur
// ═══════════════════════════════════════════════════════════════════════════

/// Fiche recette — catalogue admin (isCustom false) ou perso utilisateur (isCustom true)
/// Admin : gestion catalogue ; client : favoris + perso
model Recipe {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  /// Accroche / description courte (pitch)
  description  String?
  /// Temps total (prépa + cuisson), minutes — affichage fiche
  totalTimeMin Int?
  /// Nombre de portions couvertes par les quantités / macros / referenceYieldG
  servings     Int            @default(1)
  category     RecipeCategory
  /// Matériel nécessaire (vide = aucune contrainte particulière)
  requiredKitchenEquipment RecipeKitchenEquipment[] @default([])
  instructions String?
  active       Boolean        @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  /// Macros pour la portion de référence (saisie fiche)
  nutritionKcal      Float?
  nutritionProteinG  Float?
  nutritionCarbsG   Float?
  nutritionFatG     Float?
  nutritionFiberG   Float?

  /// false = recette catalogue admin ; true = recette créée par un utilisateur
  isCustom Boolean @default(false)
  userId   String? @db.ObjectId
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Poids total du plat pour `servings` portion(s) — base du scaling liste de courses vs Meal.quantityG. Si null, 100 g.
  referenceYieldG Float?

  /// Allergènes majeurs présents dans la recette (codes partagés avec le profil utilisateur)
  allergens String[]       @default([])

  ingredients RecipeIngredient[]
  meals       Meal[]
  favorites   UserFavoriteRecipe[]

  @@index([userId])
  @@map("recipes")
}

/// Ingrédient d'une recette
model RecipeIngredient {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId  String   @db.ObjectId
  order     Int      @default(0)
  name      String
  /// Grammes pour le scaling liste de courses ; null = hors agrégation (ex. épices au goût)
  quantityG Float?
  unit      String?
  /// Catégorie pour tri liste de courses (ex: Viandes, Légumes, Féculents)
  category  String?
  /// Note affichée (ex. apport kcal facultatif)
  note      String?
  isOptional Boolean @default(false)

  @@index([recipeId])
  @@map("recipe_ingredients")
}

/// Recettes mises en favoris par un utilisateur
model UserFavoriteRecipe {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId  String   @db.ObjectId
  createdAt DateTime @default(now())

  @@unique([userId, recipeId])
  @@map("user_favorite_recipes")
}


// ═══════════════════════════════════════════════════════════════════════════
// LOT 4 — NUTRITION : PLANNING 91 JOURS
// ═══════════════════════════════════════════════════════════════════════════

/// Journée nutritionnelle (1 entrée par userId × dayIndex)
model NutritionDay {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String   @db.ObjectId
  /// Jour du programme 1–91
  dayIndex            Int
  /// Surcharge du jeûne intermittent pour ce jour précis
  intermittentFasting Boolean  @default(false)

  meals Meal[]

  @@unique([userId, dayIndex])
  @@index([userId])
  @@map("nutrition_days")
}

/// Repas dans une journée — macros calculées et sauvegardées en BDD
model Meal {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  nutritionDay   NutritionDay @relation(fields: [nutritionDayId], references: [id], onDelete: Cascade)
  nutritionDayId String       @db.ObjectId
  position       MealPosition

  recipe   Recipe? @relation(fields: [recipeId], references: [id])
  recipeId String? @db.ObjectId
  /// Quantité calculée selon formules (en grammes)
  quantityG Float?

  /// Macros calculées par les formules et persistées
  calcProteinG Float?
  calcCarbsG   Float?
  calcFatG     Float?
  calcCalories Float?
  calcFiberG   Float?

  /// Saisie manuelle pour plats livrés partenaires
  isManual       Boolean @default(false)
  manualProteinG Float?
  manualCarbsG   Float?
  manualFatG     Float?
  manualCalories Float?
  manualFiberG   Float?

  /// Date/heure à laquelle le repas a été consommé (case cochée dans le calendrier / app)
  eatenAt        DateTime?

  @@unique([nutritionDayId, position])
  @@index([nutritionDayId])
  @@map("meals")
}


// ═══════════════════════════════════════════════════════════════════════════
// LOT 6 — LISTE DE COURSES
// Générée depuis le planning (NutritionDay → Meal → Recipe → RecipeIngredient).
// Scaling : (meal.quantityG / recipe.referenceYieldG) × ingredient.quantityG ;
// ingrédients sans quantityG exclus. Tri liste : UserProfile (catégorie / alpha).
// Détail : docs/spec-lot6-liste-courses.md
// ═══════════════════════════════════════════════════════════════════════════

model ShoppingList {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String   @db.ObjectId
  /// Début de la période (jour programme 1–91)
  startDayIndex Int
  /// Fin de la période (inclus)
  endDayIndex   Int
  generatedAt   DateTime @default(now())

  items ShoppingItem[]

  @@index([userId])
  @@map("shopping_lists")
}

/// Ligne d'ingrédient : agrégée depuis les repas (RecipeIngredient) de la période
model ShoppingItem {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  list           ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId         String       @db.ObjectId
  ingredientName String
  category       String?
  totalQuantityG Float
  unit           String?
  isChecked      Boolean      @default(false)
  /// Reporté automatiquement à la prochaine liste si non coché (Lot 6 spec)
  isReported     Boolean      @default(false)

  @@index([listId])
  @@map("shopping_items")
}


// ═══════════════════════════════════════════════════════════════════════════
// LOT 7 — GAMIFICATION
// ═══════════════════════════════════════════════════════════════════════════

/// Log de chaque gain ou dépense de points (total = somme des PointEvent)
model PointEvent {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String         @db.ObjectId
  type      PointEventType
  /// Positif = gain, négatif = dépense (échange récompense)
  amount    Int
  /// Métadonnées contextuelles (ex: {sessionId, badgeSlug, rewardId...})
  metadata  Json?
  createdAt DateTime       @default(now())

  @@index([userId])
  @@map("point_events")
}

/// Récompenses partenaires (ex: 10€ offerts pour 50€ chez Nutri Pure — coût en points)
/// Admin : création / modification des offres partenaires
model PointReward {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  slug         String   @unique
  name         String
  description  String?
  costPoints   Int
  rewardDetail String?
  partnerName  String?
  active       Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("point_rewards")
}

/// Catalogue des badges (défini par l'admin)
model Badge {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  slug        String   @unique
  name        String
  description String?
  iconUrl     String?
  /// Condition en JSON — ex: {"type":"STREAK","threshold":7}
  condition   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String    @db.ObjectId
  badge     Badge     @relation(fields: [badgeId], references: [id])
  badgeId   String    @db.ObjectId
  /// Progression 0.0 → 1.0
  progress   Float     @default(0)
  unlockedAt DateTime?

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}


// ═══════════════════════════════════════════════════════════════════════════
// LOT 8 — CHECKLIST JOURNALIÈRE (ligne directrice : admin définit les options)
// ═══════════════════════════════════════════════════════════════════════════

/// Tâches quotidiennes optionnelles définies par l'admin (réutilisées dans ProgramDayItem)
/// Admin : ajout/suppression de tâches (eau, pas de téléphone, méditation…)
model DailyTask {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  label     String
  points    Int      @default(0)
  active    Boolean  @default(true)
  order     Int      @default(0)
  updatedAt DateTime @updatedAt

  optOuts          UserDailyTaskOptOut[]
  completions      DailyTaskCompletion[]
  programDayItems ProgramDayItem[]

  @@map("daily_tasks")
}

/// Tâches que l'utilisateur a décidé de ne pas suivre (opt-out)
model UserDailyTaskOptOut {
  id     String    @id @default(auto()) @map("_id") @db.ObjectId
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String    @db.ObjectId
  task   DailyTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String    @db.ObjectId

  @@unique([userId, taskId])
  @@map("user_daily_task_opt_outs")
}

/// Cochage d'une tâche pour une date donnée
model DailyTaskCompletion {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String    @db.ObjectId
  task        DailyTask @relation(fields: [taskId], references: [id])
  taskId      String    @db.ObjectId
  /// Date du jour (sans heure — stocker à minuit UTC)
  date        DateTime
  completedAt DateTime  @default(now())

  @@unique([userId, taskId, date])
  @@index([userId])
  @@map("daily_task_completions")
}


// ═══════════════════════════════════════════════════════════════════════════
// LOT 9 — DÉCOUVERTE (Méditation / Mindset / Breathwork) — catalogue admin
// ═══════════════════════════════════════════════════════════════════════════

/// Contenu vidéo Cloudflare Stream du hub Découverte (catalogue admin)
/// Admin : ajout de vidéos sans redéploiement ; déblocage progressif par points/jour
model DiscoveryContent {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  category         DiscoveryCategory
  title            String
  /// UID Cloudflare Stream (identifiant unique de la vidéo côté Cloudflare)
  cloudflareUid    String            @unique
  order            Int               @default(0)
  active           Boolean           @default(true)
  /// Durée en secondes — renseignée par le webhook Cloudflare quand la vidéo est ready
  durationSeconds  Float?
  /// pending | ready | error — statut de traitement Cloudflare
  status           String            @default("pending")
  /// Vignette générée par Cloudflare (renseignée au webhook ready)
  thumbnailUrl     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  progress        UserVideoProgress[]
  programDayItems ProgramDayItem[]

  @@map("discovery_contents")
}


// ═══════════════════════════════════════════════════════════════════════════
// LOT 10 — PROGRESSION
// ═══════════════════════════════════════════════════════════════════════════

/// Photos de progression mensuelles (3 angles × 3 mois max)
model ProgressPhoto {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String     @db.ObjectId
  angle      PhotoAngle
  url        String
  /// Mois du programme : 1, 2 ou 3
  month      Int
  uploadedAt DateTime   @default(now())

  @@index([userId])
  @@map("progress_photos")
}

// ═══════════════════════════════════════════════════════════════════════════
// LOT 10b — SUIVI MENSUEL (Inscription + 3 mois)
// ═══════════════════════════════════════════════════════════════════════════

/// Check-in mensuel : bien-être + photos (mois 0 = inscription, 1-3 = mensuel)
model MonthlyCheckIn {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String   @db.ObjectId
  /// 0 = inscription, 1-3 = mois du programme
  month               Int
  /// Métriques bien-être (échelle 1-10)
  stressLevel         Int?
  sleepQuality        Int?
  bodyConfidence      Int?
  digestionQuality    Int?
  happinessLevel      Int?
  readinessToChange   Int?
  /// Points crédités pour ce check-in
  pointsAwarded       Boolean  @default(false)
  nutritionRecalibrated Boolean @default(false)
  submittedAt         DateTime @default(now())

  @@unique([userId, month])
  @@index([userId])
  @@map("monthly_checkins")
}

// ═══════════════════════════════════════════════════════════════════════════
// LOT 12 — ADMIN : DÉFIS PONCTUELS
// ═══════════════════════════════════════════════════════════════════════════

/// Défi ponctuel créé par l'admin (24h / 48h / semaine)
/// Admin : création / modification des défis et bonus points
model AdminChallenge {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  description  String?
  durationDays Int
  bonusPoints  Int
  startAt      DateTime
  endAt        DateTime
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  participants UserChallenge[]

  @@map("admin_challenges")
}

model UserChallenge {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String         @db.ObjectId
  challenge   AdminChallenge @relation(fields: [challengeId], references: [id])
  challengeId String         @db.ObjectId
  joinedAt    DateTime       @default(now())
  completedAt DateTime?

  @@unique([userId, challengeId])
  @@index([userId])
  @@map("user_challenges")
}


// ═══════════════════════════════════════════════════════════════════════════
// LOT 11 — WEB PUSH (notifications)
// ═══════════════════════════════════════════════════════════════════════════

model PushSubscription {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  endpoint  String
  p256dh    String   /// clé publique client (encodage base64)
  auth      String   /// secret auth (encodage base64)
  createdAt DateTime @default(now())

  @@unique([userId, endpoint])
  @@index([userId])
  @@map("push_subscriptions")
}
