datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CLIENT
}

enum ActivityLevel {
  SEDENTARY
  ACTIVE
  ATHLETE
}

// AUTH __________________________________________________________________________________
model User {
  id                        String                     @id @default(auto()) @map("_id") @db.ObjectId
  email                     String                     @unique
  username                  String?
  passwordHash              String?
  recoveryCode              String?
  emailVerified             Boolean                    @default(false)
  isMfaEnabled              Boolean                    @default(false)
  totpKey                   Bytes?
  googleId                  String?                    @unique
  name                      String?
  picture                   String?
  role                      Role                       @default(CLIENT)
  /// Fin de validité de l'accès accompagnement (null = accès à vie ou non souscrit)
  subscriptionEndsAt        DateTime?
  transactions              Transaction[]
  sessions                  Session[]
  emailVerificationRequests EmailVerificationRequest[] @relation("UserEmailVerificationRequests")
  passwordResetSessions     PasswordResetSession[]     @relation("UserPasswordResetSessions")
  measurements              Measurement[]
  pushSubscriptions         PushSubscription[]
  createdAt     DateTime @default(now())
}

model Session {
  /// ID écrit par Lucia (nanoid) → plus de contrainte ObjectId
  id                String   @id @map("_id")

  /// relation vers l'utilisateur
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String

  expiresAt         DateTime
  twoFactorVerified Boolean  @default(false)
  oauthProvider     String?

  @@index([userId])
}

model EmailVerificationRequest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation("UserEmailVerificationRequests", fields: [userId], references: [id])
  userId    String   @db.ObjectId
  email     String
  code      String
  expiresAt DateTime
}

model PasswordResetSession {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  user              User     @relation("UserPasswordResetSessions", fields: [userId], references: [id])
  userId            String   @db.ObjectId
  email             String
  code              String
  expiresAt         DateTime
  emailVerified     Boolean  @default(false)
  twoFactorVerified Boolean  @default(false)
}



// PAIEMENT __________________________________________________________________________________
model Transaction {
  id                     String   @id @default(auto()) @map("_id") @db.ObjectId
  stripePaymentId        String   @unique
  userId                 String?  @db.ObjectId
  amount                 Float
  currency               String
  status                 String
  customer_details_email String?  @default("")
  customer_details_name  String?  @default("")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user                   User?    @relation(fields: [userId], references: [id])

  @@map("transactions")
}

// MESURES / PROFIL PHYSIQUE __________________________________________________________________________________
model Measurement {
  id                         String         @id @default(auto()) @map("_id") @db.ObjectId
  userId                     String         @db.ObjectId
  user                       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                  DateTime       @default(now())

  age                        Int?
  heightCm                   Float?
  weightKg                   Float?
  waistCm                    Float?
  chestCm                    Float?
  armCm                      Float?

  intermittentFastingMorning Boolean?
  activityLevel              ActivityLevel?

  painsPathologies           String?
  contextParticular          String?
  breadManagement            String?
  sportActivity              String?

  objectives                 String[]

  @@index([userId])
}

// WEB PUSH (notifications à 21h30, etc.) __________________________________________________________________________________
model PushSubscription {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  endpoint  String
  p256dh    String   /// clé publique client (encodage base64)
  auth      String   /// secret auth (encodage base64)
  createdAt DateTime @default(now())

  @@unique([userId, endpoint])
  @@index([userId])
  @@map("push_subscriptions")
}

// CONTACT (formulaire public) __________________________________________________________________________________
model Contact {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())

  @@map("contacts")
}
